<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.mousemove" path="/org/gnome/shell/extensions/mousemove/">
    <key name="enabled" type="b">
      <default>false</default>
      <summary>Enable mouse movement</summary>
      <description>Enable automatic mouse movement to maintain presence</description>
    </key>
    <key name="check-interval" type="i">
      <default>1</default>
      <summary>Check interval in seconds</summary>
      <description>Seconds between idle time checks</description>
      <range min="1" max="60"/>
    </key>
    <key name="idle-seconds" type="i">
      <default>3</default>
      <summary>Idle time in seconds</summary>
      <description>Seconds of inactivity before moving the mouse cursor</description>
      <range min="1" max="300"/>
    </key>
    <key name="move-distance" type="i">
      <default>10</default>
      <summary>Move distance in pixels</summary>
      <description>Number of pixels to move the cursor</description>
      <range min="1" max="100"/>
    </key>
    <!-- Startup Settings -->
    <key name="separator-1" type="s">
      <default>''</default>
    </key>
    <key name="enable-on-startup" type="b">
      <default>false</default>
      <summary>Enable on startup</summary>
      <description>Automatically enable mouse movement when the extension loads</description>
    </key>
  </schema>
</schemalist>
